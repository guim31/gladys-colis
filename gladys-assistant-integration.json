  "scene_actions": [
    {
      "key": "track_parcel",
      "label": {
        "en": "Track a parcel",
        "fr": "Suivre un colis",
        "de": "Sendung verfolgen",
        "es": "Seguir un paquete"
      },
      "description": {
        "en": "Adds a parcel to the list. The number field also takes a whole text, such as a mail subject: its first tracking number is used.",
        "fr": "Ajoute un colis à la liste. Le champ numéro accepte aussi un texte entier, comme l'objet d'un mail : son premier numéro de suivi est retenu.",
        "de": "Fügt eine Sendung zur Liste hinzu. Das Nummernfeld nimmt auch einen ganzen Text, etwa einen Mail-Betreff: Seine erste Sendungsnummer wird verwendet.",
        "es": "Añade un paquete a la lista. El campo del número admite también un texto entero, como el asunto de un correo: se usa su primer número de seguimiento."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "number",
          "type": "string",
          "required": true,
          "label": {
            "en": "Tracking number or text",
            "fr": "Numéro de suivi ou texte",
            "de": "Sendungsnummer oder Text",
            "es": "Número de seguimiento o texto"
          },
          "placeholder": {
            "en": "e.g. 1Z999AA10123456784",
